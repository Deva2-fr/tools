# ============================================================
#  Deva2 Hub – configuration.  Copiez ce fichier : cp .env.example .env
#  (ou lancez `make secrets` qui crée .env avec des secrets aléatoires)
#  Ne JAMAIS publier le fichier .env (il est ignoré par git).
# ============================================================

# --- Adresse publique du Hub -------------------------------------------
# Nom de domaine (le DNS doit pointer vers le serveur). En local : localhost
DOMAIN=hub.deva2.fr
# Même adresse avec https:// devant (sert aux redirections Microsoft)
BASE_URL=https://hub.deva2.fr

# --- Secrets (générés par `make secrets`) --------------------------------
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me          # signe les sessions de connexion
ENCRYPTION_KEY=change-me      # chiffre les mots de passe/clés enregistrés en base. NE PAS PERDRE.
WEBHOOK_TOKEN=change-me       # jeton pour recevoir des alertes d'outils externes

# --- Premier compte administrateur (créé au 1er démarrage) -----------------
ADMIN_EMAIL=vous@deva2.fr
ADMIN_PASSWORD=choisissez-un-mot-de-passe-de-12-caracteres-minimum

# --- Divers ---------------------------------------------------------------
COOKIE_SECURE=true            # mettre false uniquement en test local sans HTTPS
TIMEZONE=Europe/Paris

# --- Production derrière un reverse proxy existant (docker-compose.prod.yml) ------
# Le Hub n'utilise PAS les ports 80/443 : il écoute en HTTP sur 127.0.0.1:HUB_PORT et c'est
# votre reverse proxy (celui qui gère déjà le HTTPS) qui relaie le domaine vers ce port.
HUB_PORT=31847                # port interne choisi au hasard ; à changer s'il est déjà utilisé
HUB_BIND=127.0.0.1            # mettre 0.0.0.0 si le reverse proxy tourne lui-même dans un conteneur
